{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker.ImportScripts"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["node", "vite/client"]
  },
  "include": ["src", "electron", "tests", "e2e", "e2e-pc", "e2e-android", "vite.config.ts", "vitest.config.ts", "playwright.config.ts", "playwright.pc.config.ts", "playwright.android.config.ts"]
}
