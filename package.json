{
  "name": "twin-pics",
  "productName": "Twin Pics",
  "private": true,
  "version": "0.4.0",
  "description": "Retrouver les photos en double et garder la meilleure",
  "license": "MIT",
  "author": "Super Bobiz",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite --host",
    "dev:pc": "node scripts/dev-pc.mjs",
    "build": "tsc -b && vite build && node scripts/build-electron.mjs",
    "preview": "vite preview --host",
    "pc": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win portable --publish never",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:pc": "npm run build && playwright test --config playwright.pc.config.ts",
    "e2e:exe": "node scripts/e2e-exe.mjs",
    "icon": "node scripts/make-icon.mjs"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "dexie": "^4.4.7",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "exifr": "^7.1.3",
    "fake-indexeddb": "^6.2.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "onnxruntime-node": false,
    "protobufjs": false,
    "electron-winstaller": false
  },
  "build": {
    "appId": "io.github.daviddza.twinpics",
    "productName": "Twin Pics",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Twin Pics ${version}.exe"
    }
  }
}
